<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>FOKS - Federated Open Key Service</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
      :root {
        --foks-dark: #1b1f2e;
        --foks-accent: #0d8a84;
        --foks-accent-hover: #0b756f;
        --foks-muted: #6c7a89;
        --foks-alt-bg: #f5f7fa;
        --foks-border: #e0e4ea;

        --font-display: "Fraunces", Georgia, "Times New Roman", serif;
        --font-body: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
      }
      body {
        font-family: var(--font-body);
        color: #2e3440;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* Nav */
      .navbar { border-bottom: 1px solid rgba(255,255,255,0.08); }
      .navbar-brand {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.4rem;
        letter-spacing: 0.5px;
      }

      /* Hero */
      .hero-section {
        background: var(--foks-dark);
        color: #fff;
        padding: 4.5rem 1rem 3.5rem;
      }
      .hero-section h1 {
        font-family: var(--font-display);
        font-size: clamp(2.6rem, 5vw, 3.6rem);
        font-weight: 700;
        letter-spacing: -0.025em;
        font-variation-settings: "opsz" 144;
        margin-bottom: 0.6rem;
      }
      .hero-section h2 {
        font-size: 1.2rem;
        font-weight: 400;
        color: #a0aab4;
        max-width: 540px;
        line-height: 1.55;
      }
      .hero-section img {
        max-height: 180px;
        opacity: 0.92;
      }
      .hero-news {
        display: inline-flex;
        align-items: flex-start;
        gap: 0.75rem;
        max-width: 520px;
        margin-left: auto;
        margin-right: auto;
        padding: 0.75rem 1rem 0.75rem 0.85rem;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        text-align: left;
      }
      .hero-news-label {
        flex-shrink: 0;
        background: var(--foks-accent);
        color: #fff;
        font-weight: 600;
        font-size: 0.7rem;
        letter-spacing: 0.7px;
        text-transform: uppercase;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        margin-top: 0.15rem;
      }
      .hero-news-list {
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 0.88rem;
        line-height: 1.5;
        color: #c8cdd6;
      }
      .hero-news-list li {
        display: flex;
        align-items: baseline;
        gap: 0.7rem;
      }
      .hero-news-list li + li {
        margin-top: 0.3rem;
        padding-top: 0.3rem;
        border-top: 1px solid rgba(255,255,255,0.06);
      }
      .hero-news-date {
        flex-shrink: 0;
        width: 4.5rem;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.3px;
        color: #7a8593;
        text-transform: uppercase;
      }
      .hero-news-list a {
        color: #fff;
        text-decoration: none;
        border-bottom: 1px solid rgba(255,255,255,0.35);
      }
      .hero-news-list a:hover {
        border-bottom-color: #fff;
      }

      /* Sections */
      .section { padding: 3.5rem 0; }
      .section-alt { background: var(--foks-alt-bg); }
      .section h2 {
        font-family: var(--font-display);
        font-size: clamp(1.7rem, 2.6vw, 2rem);
        font-weight: 600;
        letter-spacing: -0.015em;
        margin-bottom: 1.75rem;
      }
      .section h3 {
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin-bottom: 0.6rem;
      }
      .section p { color: #444c56; }

      /* Feature rows (what, how, why) */
      .feature-row { margin-bottom: 2.5rem; }
      .feature-row:last-child { margin-bottom: 0; }
      .feature-row img {
        max-width: 100%;
        max-height: 220px;
        object-fit: contain;
      }

      /* Code blocks */
      .code-card {
        background: #1e2433;
        border: 1px solid #2a3040;
        border-radius: 8px;
        overflow: hidden;
      }
      .code-card pre {
        margin: 0;
        padding: 1rem 1.25rem;
        font-family: var(--font-mono);
        font-size: 0.82rem;
        line-height: 1.65;
        color: #c8ccd4;
        white-space: pre-wrap;
        word-break: break-word;
      }

      /* Download tabs */
      .nav-tabs .nav-link { font-size: 0.9rem; }
      .tab-content .code-card { border-radius: 0 0 8px 8px; }

      /* White paper card */
      .whitepaper-card {
        border: 2px solid var(--foks-border);
        border-radius: 12px;
        padding: 2.5rem 2rem;
        background: #fff;
      }
      .whitepaper-card h2 { margin-bottom: 0.75rem; }
      .whitepaper-card p { color: #555; margin-bottom: 1.5rem; }
      .whitepaper-icon {
        font-size: 2.5rem;
        margin-bottom: 0.75rem;
      }

      /* Accordions */
      .accordion-item { border-color: var(--foks-border); }
      .accordion-button {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.15rem;
        letter-spacing: -0.005em;
        padding: 1rem 1.25rem;
      }
      .accordion-button:not(.collapsed) {
        background: var(--foks-alt-bg);
        color: var(--foks-dark);
        box-shadow: none;
      }
      .accordion-button:focus { box-shadow: none; border-color: var(--foks-border); }
      .accordion-body p { color: #444c56; }

      /* Small utility sections */
      .compact-section { padding: 2.5rem 0; }
      .compact-section h2 {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1rem;
      }

      /* CTA buttons */
      .btn-foks {
        background: var(--foks-accent);
        border-color: var(--foks-accent);
        color: #fff;
        font-weight: 500;
      }
      .btn-foks:hover {
        background: var(--foks-accent-hover);
        border-color: var(--foks-accent-hover);
        color: #fff;
      }

      /* Footer */
      footer {
        background: var(--foks-dark);
        color: var(--foks-muted);
        padding: 2rem 1rem;
      }
      footer a { color: #a0aab4; }

      /* Responsiveness */
      @media (max-width: 767px) {
        .hero-section { padding: 3rem 1rem 2.5rem; }
        .section { padding: 2.5rem 0; }
        .feature-row img { max-height: 160px; margin-bottom: 1rem; }
      }
    </style>
  </head>
  <body>

    {{{body}}}

    <footer class="text-center">
      <p class="mb-0">&copy; 2025 <a href="https://ne43.com">ne43, Inc</a>. All rights reserved.</p>
    </footer>

    <script src="/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
